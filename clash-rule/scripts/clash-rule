#!/bin/bash
# clash-rule — 给本机 Clash Verge Rev 添加/删除/查询 分流规则(直连、代理、拒绝)
# 用法:
#   clash-rule direct <域名> [域名...]   # 域名及其所有子域 直连(DIRECT)
#   clash-rule proxy  <域名> [域名...]   # 域名走代理(默认组「🚀 节点选择」,可用环境变量 CLASH_RULE_PROXY_GROUP 覆盖)
#   clash-rule reject <域名> [域名...]   # 拒绝连接(屏蔽广告/追踪用)
#   clash-rule remove <域名> [域名...]   # 删除本工具添加的规则(payload 等于该域名的 DOMAIN 系规则都会删)
#   clash-rule list                     # 查看当前前置规则(规则链文件)
#   clash-rule status                   # 诊断:当前订阅/分组选择/规则头/常见坑
#   clash-rule select <分组> <选项>      # 切换分组选择(如: clash-rule select 全球直连 DIRECT;组名可不带emoji)
#   clash-rule mode <rule|global|direct> # 切内核出站模式:三层同步(内核+运行时文件+Verge持久层),切回rule时自动断GLOBAL旧连接
# 原理:规则同时写入 ①订阅的「编辑规则」链文件(订阅更新后仍保留) ②运行时配置 clash-verge.yaml(自动热重载,立即生效),
#       并断开这些域名的存量旧连接让浏览器立刻用新链路重连。所有操作幂等(同域名重复执行/切换策略均正确),
#       写入原子化(临时文件+rename),改动前自动留 .clash-rule.bak 备份(仅当当前文件是有效 YAML 时才覆盖备份)。
#       重载前会把运行时文件 mode 归一为内核当前值,防止把陈旧模式(如手切后未同步的 global)回灌内核架空所有规则。
set -u

APPDIR="$HOME/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev"
RUNTIME="$APPDIR/clash-verge.yaml"
PROFILES_YAML="$APPDIR/profiles.yaml"
LOCK="$APPDIR/.clash-rule.lock"
RELOAD_FAILED=0

die() { echo "❌ $*" >&2; exit 1; }

[ -f "$RUNTIME" ] || die "找不到 $RUNTIME —— 本机装的是 Clash Verge Rev 吗?"

# 依赖预检:缺 PyYAML 时 chain_file() 会静默失败并给出误导性报错,提前拦下
python3 -c "import yaml" 2>/dev/null || die "python3 缺少 PyYAML 模块。安装: pip3 install --user pyyaml (或 brew install pyyaml)"

# 提取内核 API 入口:只去首尾空白与成对引号,绝不动路径/密钥中间的空格
SOCK=$(grep -m1 '^external-controller-unix:' "$RUNTIME" | sed -E 's/^[^:]+:[[:space:]]*//; s/^"//; s/"[[:space:]]*$//')
SECRET=$(grep -m1 '^secret:' "$RUNTIME" | sed -E 's/^secret:[[:space:]]*//; s/^"//; s/"[[:space:]]*$//')
API_UP=0
[ -n "${SOCK:-}" ] && [ -S "$SOCK" ] && API_UP=1
api() { curl -s -m 10 --unix-socket "$SOCK" -H "Authorization: Bearer $SECRET" "$@"; }
urlencode() { python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"; }

# 防并发:两个实例同时读改写同一文件会互相丢规则。macOS 无 flock(1),用 mkdir 原子抢锁
acquire_lock() {
    mkdir "$LOCK" 2>/dev/null || die "另一个 clash-rule 正在运行(锁 ${LOCK})。确认没有后可手动删掉该锁目录重试"
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT
}
backup() {
    [ -f "$1" ] || return 0
    if python3 -c "import sys,yaml; yaml.safe_load(open(sys.argv[1]))" "$1" >/dev/null 2>&1; then
        cp -p "$1" "$1.clash-rule.bak"
    else
        echo "⚠️  跳过备份:${1} 当前不是有效 YAML(疑似已损坏),不覆盖旧备份"
    fi
}

# 定位当前订阅的规则链文件(对应界面 右键订阅→编辑规则)
chain_file() {
    python3 - "$PROFILES_YAML" "$APPDIR" <<'PY'
import os, sys, yaml
try:
    pf = yaml.safe_load(open(sys.argv[1]))
    item = next((i for i in pf.get("items", []) if i.get("uid") == pf.get("current")), None)
    rules = (item.get("option") or {}).get("rules") if item else None
    if rules:
        print(os.path.join(sys.argv[2], "profiles", rules if rules.endswith((".yaml", ".yml")) else rules + ".yaml"))
except Exception:
    pass
PY
}

validate_domain() {
    echo "$1" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'
}

# 策略/分组预检:别把引用不存在策略的规则写进文件——那会让内核/重启后配置持续加载失败
check_policy() {
    case "$1" in DIRECT|REJECT|REJECT-DROP|PASS) return 0 ;; esac
    [ "$API_UP" = 1 ] || return 0
    local code
    code=$(api -o /dev/null -w '%{http_code}' "http://localhost/proxies/$(urlencode "$1")")
    [ "$code" = "200" ] || die "策略/分组「${1}」不存在(HTTP ${code})。可用分组: clash-rule status"
}

# 改规则链文件:同域名旧规则先清,新规则插到最前;三键必须齐全否则 Verge 会静默忽略整个文件
edit_chain() {  # $1=file $2=domain $3=policy $4=action(add/remove)
    python3 - "$@" <<'PY'
import os, sys, tempfile, yaml
path, domain, policy, action = sys.argv[1:5]
try:
    d = yaml.safe_load(open(path)) or {}
except Exception as e:
    sys.exit(f"链文件解析失败({e}),为安全起见未修改")
if not isinstance(d, dict):
    sys.exit("链文件结构异常(顶层不是映射),未修改")
for k in ("prepend", "append", "delete"):  # 容忍 null,当空列表处理
    if d.get(k) is None:
        d[k] = []
if not all(isinstance(d.get(k), list) for k in ("prepend", "append", "delete")):
    sys.exit("链文件结构异常(prepend/append/delete 必须都是列表),未修改")
pre = [r for r in d["prepend"] if not (isinstance(r, str) and r.split(",")[1:2] == [domain])]
if action == "add":
    pre.insert(0, f"DOMAIN-SUFFIX,{domain},{policy}")
d["prepend"] = pre
header = "# Profile Enhancement Rules Template for Clash Verge\n"
out = header + yaml.safe_dump(d, allow_unicode=True, default_flow_style=False, sort_keys=False, width=4096)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".clash-rule-tmp.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(out)
    os.replace(tmp, path)  # 原子替换,中断不会留下半截文件
except BaseException:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
}

# 改运行时配置:纯文本行级增删,不做整文件 YAML 重序列化(45万字节文件重排风险高)
# 输出: exists=规则已存在且策略相同(未改文件) / switch=同域名切换了策略 / 空=新增
edit_runtime() {  # $1=domain $2=policy $3=action(add/remove)
    python3 - "$RUNTIME" "$1" "$2" "$3" <<'PY'
import os, re, sys, tempfile
path, domain, policy, action = sys.argv[1:5]
text = open(path, encoding="utf-8").read()
pat = re.compile(r"^- (DOMAIN[A-Z-]*," + re.escape(domain) + r"),([^\n]*)\n?", re.M)
def atomic_write(s):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".clash-rule-tmp.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(s)
        os.replace(tmp, path)
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise
if action == "remove":
    atomic_write(pat.sub("", text))
else:
    found = pat.findall(text)
    if found == [(f"DOMAIN-SUFFIX,{domain}", policy)]:
        print("exists"); sys.exit(0)
    stripped = pat.sub("", text)
    m = re.search(r"^rules:$", stripped, re.M)
    if not m:
        sys.exit("运行时配置里找不到顶层 rules:")
    atomic_write(stripped[:m.end()] + f"\n- DOMAIN-SUFFIX,{domain},{policy}" + stripped[m.end():])
    if found:
        print("switch")
PY
}

reload_core() {
    [ "$API_UP" = 1 ] || { echo "ℹ️  Clash 内核未在运行:规则已写入文件,下次启动 Clash Verge 自动生效"; return 0; }
    # 前置归一化:重载是整文件 PUT,会连带覆盖内核实时状态;先把文件 mode 行对齐内核当前值,
    # 防止把陈旧模式(如用户在 UI 切回 rule 后文件还留着 global)回灌内核、架空所有规则
    local km fm
    km=$(kernel_mode)
    if [ -n "$km" ]; then
        fm=$(file_mode "$RUNTIME")
        if [ -n "$fm" ] && [ "$fm" != "$km" ]; then
            if set_file_mode "$RUNTIME" "$km"; then
                echo "ℹ️  已将运行时文件 mode 由 ${fm} 归一为内核当前值 ${km}(防重载回灌)"
            else
                echo "⚠️  归一化失败:本次重载可能把陈旧模式(${fm})回灌内核,建议稍后执行 clash-rule mode ${km}"
            fi
        fi
    fi
    local code
    code=$(api -o /dev/null -w '%{http_code}' -X PUT -H "Content-Type: application/json" \
        -d "{\"path\": \"$RUNTIME\"}" "http://localhost/configs?force=true")
    if [ "$code" = "204" ]; then return 0; fi
    RELOAD_FAILED=1
    echo "⚠️  热重载失败(HTTP ${code}):规则已写入文件,重启 Clash Verge 后生效"
}

# 断掉这些域名的存量连接(长连接不会自动换链路),并返回断开条数
close_stale() {  # $@=domains
    [ "$API_UP" = 1 ] || { echo 0; return 0; }
    local tmp ids n=0 id
    tmp=$(mktemp) || { echo 0; return 0; }
    api http://localhost/connections > "$tmp" 2>/dev/null
    ids=$(python3 - "$tmp" "$@" <<'PY'
import json, sys
try:
    conns = json.load(open(sys.argv[1])).get("connections") or []
except Exception:
    sys.exit(0)
domains = sys.argv[2:]
for c in conns:
    h = (c["metadata"].get("host") or "").lower()
    if any(h == d or h.endswith("." + d) for d in domains):
        print(c["id"])
PY
)
    rm -f "$tmp"
    while IFS= read -r id; do
        [ -n "$id" ] && api -f -X DELETE "http://localhost/connections/$id" -o /dev/null 2>/dev/null && n=$((n+1))
    done <<< "$ids"
    echo $n
}

verify_rules() {  # $@=domains: 打印每个域名命中的第一条生效规则及位置
    [ "$API_UP" = 1 ] || return 0
    local tmp; tmp=$(mktemp) || return 0
    api http://localhost/rules > "$tmp" 2>/dev/null
    python3 - "$tmp" "$@" <<'PY'
import json, sys
try:
    rules = json.load(open(sys.argv[1]))["rules"]
except Exception:
    print("  ⚠️  无法读取内核规则列表"); sys.exit(0)
for d in sys.argv[2:]:
    hit = next((i for i, r in enumerate(rules)
                if r["type"] == "DomainSuffix" and r["payload"] == d), None)
    if hit is None:
        print(f"  ⚠️  {d}: 未在生效规则中找到")
    else:
        print(f"  ✅ {d}: 第{hit+1}条 -> {rules[hit]['proxy']}")
PY
    rm -f "$tmp"
}

file_mode() {  # $1=file: 读顶层 mode: 行的值(rule/global/direct),没有或格式异常输出空
    [ -f "$1" ] || { echo ""; return 0; }
    python3 - "$1" <<'PY'
import re, sys
pat = re.compile(r'^mode:[ \t]*["\']?(rule|global|direct)["\']?[ \t]*(?:#.*)?\r?$', re.M)
m = pat.search(open(sys.argv[1], encoding="utf-8").read())
print(m.group(1) if m else "")
PY
}

kernel_mode() {  # 内核当前 mode;内核未运行或读取失败输出空
    [ "$API_UP" = 1 ] || { echo ""; return 0; }
    api http://localhost/configs | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("mode",""))
except Exception: print("")'
}

set_file_mode() {  # $1=file $2=mode: 行级原子改顶层 mode 行(无则插到文件头);已是目标值则不动
    python3 - "$1" "$2" <<'PY'
import os, re, sys, tempfile
path, mode = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8").read()
pat = re.compile(r'^mode:[ \t]*["\']?(rule|global|direct)["\']?[ \t]*(?:#.*)?\r?$', re.M)
loose = re.compile(r'^mode[ \t]*:', re.M)  # 任何长得像顶层 mode 键的行
if pat.search(text):
    new = pat.sub(f"mode: {mode}", text, count=1)
elif loose.search(text):
    m = loose.search(text)
    sys.exit(f"发现无法解析的 mode 行({m.group(0)!r}),为避免产生重复键拒绝修改,请手工查看该文件")
else:
    new = f"mode: {mode}\n" + text
if new == text:
    sys.exit(0)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".clash-rule-tmp.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(new)
    os.chmod(tmp, os.stat(path).st_mode)  # 保留原文件权限(如 config.yaml 的 644)
    os.replace(tmp, path)  # 原子替换,中断不会留下半截文件
except BaseException:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
}

close_global_conns() {  # 断掉仍挂在 GLOBAL 链路的存量连接(长连接不会自动换链路),返回断开条数
    [ "$API_UP" = 1 ] || { echo 0; return 0; }
    local tmp ids n=0 id
    tmp=$(mktemp) || { echo 0; return 0; }
    api http://localhost/connections > "$tmp" 2>/dev/null
    ids=$(python3 - "$tmp" <<'PY'
import json, sys
try:
    conns = json.load(open(sys.argv[1])).get("connections") or []
except Exception:
    sys.exit(0)
for c in conns:
    chains = c.get("chains") or []
    if chains and chains[-1] == "GLOBAL":
        print(c["id"])
PY
)
    rm -f "$tmp"
    while IFS= read -r id; do
        [ -n "$id" ] && api -f -X DELETE "http://localhost/connections/$id" -o /dev/null 2>/dev/null && n=$((n+1))
    done <<< "$ids"
    echo $n
}

warn_mode() {  # mode 非 rule 时,规则验证/分组切换都不代表实际链路,先示警
    [ "$API_UP" = 1 ] || return 0
    local m; m=$(kernel_mode)
    if [ -n "$m" ] && [ "$m" != "rule" ]; then
        echo "  ⚠️  内核处于 ${m} 模式:以下结果不代表实际链路(规则被架空)!修复: clash-rule mode rule"
    fi
}

cmd_add() {  # $1=policy $2...=domains
    local policy="$1"; shift
    [ $# -ge 1 ] || die "未指定域名"
    local CHAIN; CHAIN=$(chain_file)
    [ -n "$CHAIN" ] && [ -f "$CHAIN" ] || die "当前订阅没有「编辑规则」链文件。请先在 Clash Verge 里 右键订阅卡片→编辑规则→保存 一次(内容不用改),再运行本命令"
    check_policy "$policy"
    acquire_lock
    backup "$CHAIN"; backup "$RUNTIME"
    local d out
    for d in "$@"; do
        d=$(printf '%s' "$d" | tr '[:upper:]' '[:lower:]')
        validate_domain "$d" || die "「${d}」不是合法域名"
        out=$(edit_runtime "$d" "$policy" add) || die "写运行时配置失败"
        edit_chain "$CHAIN" "$d" "$policy" add || die "写规则链文件失败"
        case "$out" in
            exists)  echo "↷  ${d}: 规则已存在,无需修改" ;;
            switch)  echo "⇄ ${d}: 策略已切换 -> ${policy}" ;;
            *)       echo "＋ DOMAIN-SUFFIX,${d},${policy}" ;;
        esac
    done
    reload_core
    local n; n=$(close_stale "$@")
    [ "$n" = "0" ] || echo "🔌 已断开 ${n} 条旧连接(会自动用新链路重连)"
    [ "$RELOAD_FAILED" = 0 ] || echo "⚠️  注意:内核未应用新规则,以下验证反映的是旧状态"
    echo "生效验证:"
    warn_mode
    verify_rules "$@"
}

cmd_remove() {
    [ $# -ge 1 ] || die "未指定域名"
    local CHAIN; CHAIN=$(chain_file)
    [ -n "$CHAIN" ] && [ -f "$CHAIN" ] || die "当前订阅没有规则链文件,无可删除项"
    acquire_lock
    backup "$CHAIN"; backup "$RUNTIME"
    local d
    for d in "$@"; do
        d=$(printf '%s' "$d" | tr '[:upper:]' '[:lower:]')
        validate_domain "$d" || die "「${d}」不是合法域名"
        edit_runtime "$d" "" remove || die "改运行时配置失败"
        edit_chain "$CHAIN" "$d" "" remove || die "改规则链文件失败"
        echo "－ 已删除 ${d} 的自定义规则"
    done
    reload_core
    local n; n=$(close_stale "$@")
    [ "$n" = "0" ] || echo "🔌 已断开 ${n} 条旧连接"
    [ "$RELOAD_FAILED" = 0 ] || echo "⚠️  注意:内核未应用变更,以下验证反映的是旧状态"
    echo "生效验证:"
    warn_mode
    verify_rules "$@"
}

cmd_list() {
    local CHAIN; CHAIN=$(chain_file)
    if [ -n "$CHAIN" ] && [ -f "$CHAIN" ]; then
        echo "前置规则(链文件 $(basename "$CHAIN"),订阅更新后仍保留,优先级最高):"
        python3 - "$CHAIN" <<'PY'
import sys, yaml
try:
    d = yaml.safe_load(open(sys.argv[1])) or {}
    pre = [r for r in (d.get("prepend") or []) if isinstance(r, str)]
except Exception:
    sys.exit("  (链文件解析失败——若 Verge 未应用自定义规则,这就是原因;备份在同目录 .clash-rule.bak)")
for r in pre:
    print("  -", r)
if not pre:
    print("  (空)")
PY
    else
        echo "(当前订阅没有规则链文件)"
    fi
}

cmd_status() {
    python3 - "$PROFILES_YAML" <<'PY'
import sys, yaml
try:
    pf = yaml.safe_load(open(sys.argv[1]))
    item = next((i for i in pf.get("items", []) if i.get("uid") == pf.get("current")), None)
    print(f"当前订阅: {item.get('name')} ({pf.get('current')})" if item else "找不到当前订阅")
except Exception as e:
    print(f"profiles.yaml 读取失败: {e}")
PY
    cmd_list
    if [ "$API_UP" = 1 ]; then
        echo "内核状态:"
        local g now dnow=""
        for g in "🎯 全球直连" "🚀 节点选择"; do
            now=$(api "http://localhost/proxies/$(urlencode "$g")" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("now","?"))
except Exception: print("?")')
            echo "  分组「${g}」当前选择: ${now}"
            [ "$g" = "🎯 全球直连" ] && dnow="$now"
        done
        if [ "$dnow" != "DIRECT" ]; then
            echo "  ⚠️  「全球直连」分组当前是 ${dnow}——所有国内直连规则实际会被引到这个出口!修复: clash-rule select 全球直连 DIRECT"
        fi
        local km fm cm drift=0
        km=$(kernel_mode); fm=$(file_mode "$RUNTIME"); cm=$(file_mode "$APPDIR/config.yaml" 2>/dev/null)
        echo "  出站模式: 内核=${km:-?} 运行时文件=${fm:-无} 持久层=${cm:-无}"
        if [ -n "$km" ] && [ "$km" != "rule" ]; then
            echo "  ⚠️  内核处于 ${km} 模式——所有分流规则被架空,全部流量走 GLOBAL 组当前节点!修复: clash-rule mode rule"
        fi
        [ -n "$km" ] && [ -n "$fm" ] && [ "$km" != "$fm" ] && drift=1
        [ -n "$km" ] && [ -n "$cm" ] && [ "$km" != "$cm" ] && drift=1
        [ -n "$fm" ] && [ -n "$cm" ] && [ "$fm" != "$cm" ] && drift=1
        if [ "$drift" = 1 ]; then
            echo "  ⚠️  mode 三层不一致(见上)——本工具重载前会把文件对齐内核值,但 Verge 重启/重生成时以持久层为准。建议: clash-rule mode <目标值>"
        fi
        echo "运行时规则前5条:"
        sed -n '/^rules:/,+5p' "$RUNTIME" | sed 's/^/  /'
    else
        echo "内核状态: 未检测到运行中的 Clash(仅展示文件配置)"
        local fm cm
        fm=$(file_mode "$RUNTIME"); cm=$(file_mode "$APPDIR/config.yaml" 2>/dev/null)
        echo "  出站模式: 运行时文件=${fm:-无} 持久层=${cm:-无}"
        if [ -n "$fm" ] && [ -n "$cm" ] && [ "$fm" != "$cm" ]; then
            echo "  ⚠️  两文件 mode 不一致,重启 Clash Verge 后以持久层(${cm})为准"
        fi
    fi
}

put_select() {  # $1=组名 $2=选项; 输出 HTTP 状态码
    api -o /dev/null -w '%{http_code}' -X PUT -H "Content-Type: application/json" \
        -d "{\"name\": \"$2\"}" "http://localhost/proxies/$(urlencode "$1")"
}

cmd_select() {  # $1=组名 $2=选项; 组名可不带 emoji/空格,自动模糊匹配唯一分组
    [ "$API_UP" = 1 ] || die "Clash 内核未运行"
    acquire_lock
    local group="$1" member="$2" code real
    code=$(put_select "$group" "$member")
    if [ "$code" = "404" ]; then
        real=$(api http://localhost/proxies | python3 -c '
import json, sys
try:
    ps = json.load(sys.stdin)["proxies"]
except Exception:
    sys.exit(1)
key = sys.argv[1].replace(" ", "")
hits = [n for n, p in ps.items() if p.get("type") in ("Selector", "URLTest") and key in n.replace(" ", "")]
print(hits[0] if len(hits) == 1 else ("AMBIG:" + "|".join(hits) if hits else ""))' "$group")
        if [ -n "$real" ] && [[ "$real" != AMBIG:* ]]; then
            echo "↷  按名称自动匹配分组:「${real}」"
            group="$real"; code=$(put_select "$group" "$member")
        elif [[ "$real" == AMBIG:* ]]; then
            die "「${group}」匹配到多个分组: ${real#AMBIG:} —— 请用完整名称"
        fi
    fi
    [ "$code" = "204" ] || die "切换失败(HTTP ${code}):分组「${group}」或选项「${member}」不存在"
    echo "✅ 「${group}」→ ${member}"
    local m; m=$(kernel_mode)
    if [ -n "$m" ] && [ "$m" != "rule" ]; then
        echo "⚠️  内核处于 ${m} 模式:除 GLOBAL 组外,分组选择暂不参与分流。修复: clash-rule mode rule"
    fi
}

cmd_mode() {  # $1=rule|global|direct: 三层同步切换(内核+运行时文件+Verge持久层),幂等
    local target="$1" km fm cm fail=0
    case "$target" in rule|global|direct) ;; *) die "用法: clash-rule mode <rule|global|direct>" ;; esac
    km=$(kernel_mode); fm=$(file_mode "$RUNTIME"); cm=$(file_mode "$APPDIR/config.yaml" 2>/dev/null)
    if [ "$km" = "$target" ] && [ "$fm" = "$target" ] && [ "$cm" = "$target" ]; then
        echo "↷  三层(内核/运行时文件/持久层)已是 ${target},未改动"
        return 0
    fi
    acquire_lock
    backup "$RUNTIME"
    [ -f "$APPDIR/config.yaml" ] && backup "$APPDIR/config.yaml"
    set_file_mode "$RUNTIME" "$target" || { echo "❌ 改运行时文件失败(内核与持久层未动)"; return 1; }
    if [ -f "$APPDIR/config.yaml" ]; then
        set_file_mode "$APPDIR/config.yaml" "$target" || { echo "❌ 改持久层 config.yaml 失败(运行时文件已改为 ${target},重启 Verge 后会回弹)"; fail=1; }
    fi
    if [ "$API_UP" = 1 ]; then
        local code km_now
        code=$(api -o /dev/null -w '%{http_code}' -X PATCH -H "Content-Type: application/json" \
            -d "{\"mode\": \"$target\"}" "http://localhost/configs")
        if [ "$code" = "204" ]; then
            echo "✅ 内核出站模式 -> ${target}"
        else
            km_now=$(kernel_mode)
            echo "⚠️  内核 PATCH 失败(HTTP ${code}):运行时文件=$(file_mode "$RUNTIME") 持久层=$(file_mode "$APPDIR/config.yaml" 2>/dev/null) 内核=${km_now:-未知}。可重试本命令,或重启 Clash Verge 后以文件为准"
            return 1
        fi
    else
        echo "ℹ️  Clash 内核未在运行:文件层已改,下次启动生效"
    fi
    if [ "$target" = "rule" ]; then
        local n; n=$(close_global_conns)
        [ "$n" = "0" ] || echo "🔌 已断开 ${n} 条 GLOBAL 链路旧连接(会自动按规则重连)"
    fi
    [ "$fail" = 1 ] && echo "⚠️  注意:持久层未改成功,重启 Clash Verge 后 mode 会回弹,请重试本命令"
    echo "验证: 内核=$(kernel_mode) 运行时文件=$(file_mode "$RUNTIME") 持久层=$(file_mode "$APPDIR/config.yaml" 2>/dev/null)"
    [ "$fail" = 1 ] && return 1
    return 0
}

case "${1:-help}" in
    direct) shift; cmd_add "DIRECT" "$@" ;;
    proxy)  shift; cmd_add "${CLASH_RULE_PROXY_GROUP:-🚀 节点选择}" "$@" ;;
    reject) shift; cmd_add "REJECT" "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list)   cmd_list ;;
    status) cmd_status ;;
    select) shift; [ $# = 2 ] || die "用法: clash-rule select <分组名> <选项名>"; cmd_select "$1" "$2" ;;
    mode)   shift; [ $# = 1 ] || die "用法: clash-rule mode <rule|global|direct>"; cmd_mode "$1" ;;
    *)      echo "clash-rule — Clash Verge Rev 分流规则管理"; echo; awk 'NR>1 { if ($0 ~ /^#/) { sub(/^# ?/, ""); print; next } if ($0 ~ /^[[:space:]]*$/) next; exit }' "$0" ;;
esac
